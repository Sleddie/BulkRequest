<UserControl x:Class="BulkRequest.App.Wpf.CustomCheckListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BulkRequest.App.Wpf"
             mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <CheckBox x:Name="_checkAllBox" DockPanel.Dock="Top" VerticalContentAlignment="Center"
                  Checked="CheckAllBox_CheckedChanged" Unchecked="CheckAllBox_CheckedChanged">
            <Label x:Name="_checkAllBoxLabel" Padding="2" Target="{Binding ElementName=_checkAllBox}"
                   Content="Выбрать все" VerticalContentAlignment="Center"/>
        </CheckBox>
        <ListBox x:Name="_listBox">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=local:CustomCheckListBox}}">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=local:CustomCheckListBox}}"
                                        Value="Horizontal">
                                        <Setter
                                            Property="Width"
                                            Value="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}"/>
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=local:CustomCheckListBox}}"
                                        Value="Vertical">
                                        <Setter
                                            Property="Height"
                                            Value="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportHeight}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                    </WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</UserControl>