<UserControl x:Class="BulkRequest.App.Wpf.LogMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BulkRequest.App.Wpf"
             mc:Ignorable="d">
    <Grid>
        <GroupBox>
            <GroupBox.Header>
                <Label Content="_Журнал" Target="{Binding ElementName=_logTextBox}"/>
            </GroupBox.Header>
            <TextBox x:Name="_logTextBox" Background="Black" BorderBrush="{x:Null}" Foreground="White"/>
        </GroupBox>
    </Grid>
</UserControl>
